{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["tsconfig.base.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "check-types": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    },
    "check:package": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "check:api": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "etc/**",
        "api-extractor.json",
        "tsconfig.json",
        "$TURBO_ROOT$/api-extractor.base.json",
        "$TURBO_ROOT$/tsconfig.base.json"
      ],
      "outputs": []
    },
    "update:api": {
      "dependsOn": ["^build"],
      "cache": false
    }
  }
}
