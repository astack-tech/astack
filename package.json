{
  "name": "astack",
  "version": "0.1.0",
  "description": "A composable framework for building AI applications.",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check-types": "turbo run check-types && tsc -p tsconfig.json",
    "test": "turbo run test",
    "verify": "pnpm format:check && pnpm build && pnpm lint && pnpm check-types && pnpm test && pnpm test:scripts && pnpm check:packages && pnpm check:api && pnpm check:docs && pnpm check:examples",
    "clean": "turbo run clean && rm -rf node_modules",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && node scripts/publish-packages.mjs",
    "pre:beta": "changeset pre enter beta",
    "pre:exit": "changeset pre exit",
    "sync:examples": "node scripts/sync-examples.mjs",
    "check:examples": "node scripts/sync-examples.mjs && git diff --exit-code -- website/content/examples website/content/release.json && test -z \"$(git ls-files --others --exclude-standard -- website/content/examples website/content/release.json)\"",
    "check:packages": "turbo run check:package",
    "docs:api": "typedoc",
    "check:api": "turbo run check:api",
    "update:api": "turbo run update:api",
    "check:docs": "typedoc && git diff --exit-code -- website/content/api && test -z \"$(git ls-files --others --exclude-standard -- website/content/api)\"",
    "release:dry-run": "pnpm build && node scripts/publish-packages.mjs --dry-run",
    "test:scripts": "node --test scripts/__tests__/*.test.mjs",
    "test:e2e": "node scripts/e2e-llm.mjs"
  },
  "keywords": [
    "ai-framework",
    "ai-agent",
    "ai"
  ],
  "author": "xiaoa",
  "license": "MIT",
  "packageManager": "pnpm@10.24.0+sha512.01ff8ae71b4419903b65c60fb2dc9d34cf8bb6e06d03bde112ef38f7a34d6904c424ba66bea5cdcf12890230bf39f9580473140ed9c946fef328b6e5238a345a",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.60.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-tsdoc": "^0.5.4",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "turbo": "^2.11.10",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5"
  }
}
