{
  "name": "astack",
  "version": "0.1.0",
  "description": "A composable framework for building AI applications.",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check-types": "turbo run check-types && tsc -p tsconfig.json",
    "test": "turbo run test",
    "verify": "pnpm format:check && pnpm lint && pnpm check-types && pnpm test && pnpm build",
    "clean": "turbo run clean && rm -rf node_modules",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "pre:beta": "changeset pre enter beta",
    "pre:exit": "changeset pre exit"
  },
  "keywords": [
    "ai-framework",
    "ai-agent",
    "ai"
  ],
  "author": "xiaoa",
  "license": "MIT",
  "packageManager": "pnpm@10.24.0+sha512.01ff8ae71b4419903b65c60fb2dc9d34cf8bb6e06d03bde112ef38f7a34d6904c424ba66bea5cdcf12890230bf39f9580473140ed9c946fef328b6e5238a345a",
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5"
  }
}
