{
  "name": "@astack-tech/integrations",
  "version": "0.2.0-beta.12",
  "description": "Model provider integrations for AStack, starting with DeepSeek through the OpenAI-compatible API.",
  "keywords": [
    "astack",
    "llm",
    "deepseek",
    "openai-compatible",
    "model-provider",
    "typescript"
  ],
  "homepage": "https://astack.tech/docs",
  "bugs": {
    "url": "https://github.com/astack-tech/astack/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astack-tech/astack.git",
    "directory": "packages/integrations"
  },
  "license": "MIT",
  "author": "AStack contributors",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./model-provider": {
      "types": {
        "import": "./dist/model-provider/index.d.ts",
        "require": "./dist/model-provider/index.d.cts"
      },
      "import": "./dist/model-provider/index.js",
      "require": "./dist/model-provider/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/__tests__",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "check-types": "tsc -p tsconfig.json",
    "test": "vitest run --coverage",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "check:package": "publint --strict && attw --pack . --profile node16",
    "check:api": "tsc -p tsconfig.json --noEmit false --emitDeclarationOnly --declarationMap false --outDir temp/dts && api-extractor run",
    "update:api": "tsc -p tsconfig.json --noEmit false --emitDeclarationOnly --declarationMap false --outDir temp/dts && api-extractor run --local"
  },
  "dependencies": {
    "@astack-tech/core": "workspace:*",
    "openai": "^6.10.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
