{
  "name": "@astack-tech/tools",
  "version": "0.2.0-beta.1",
  "description": "Tool definitions for AStack agents: function tools, tool sets, component tools and MCP tools.",
  "keywords": [
    "astack",
    "ai-agent",
    "tools",
    "function-calling",
    "mcp",
    "llm",
    "typescript"
  ],
  "homepage": "https://astack.tech/docs",
  "bugs": {
    "url": "https://github.com/astack-tech/astack/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astack-tech/astack.git",
    "directory": "packages/tools"
  },
  "license": "MIT",
  "author": "AStack contributors",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/__tests__",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "check-types": "tsc -p tsconfig.json",
    "test": "vitest run --coverage",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "check:package": "publint --strict && attw --pack . --profile node16",
    "check:api": "tsc -p tsconfig.json --noEmit false --emitDeclarationOnly --declarationMap false --outDir temp/dts && api-extractor run",
    "update:api": "tsc -p tsconfig.json --noEmit false --emitDeclarationOnly --declarationMap false --outDir temp/dts && api-extractor run --local"
  },
  "dependencies": {
    "@astack-tech/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.5",
    "tsup": "^9.0.0",
    "typescript": "^5.8.3",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
