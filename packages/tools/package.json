{
  "name": "@astack-tech/tools",
  "version": "0.1.1-beta.0",
  "description": "Tools for the Astack AI Framework.",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "check-types": "tsc -p tsconfig.json",
    "test": "vitest run --coverage",
    "clean": "rimraf dist"
  },
  "keywords": [
    "ai-framework",
    "ai-agent",
    "ai"
  ],
  "author": "xiaoa",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.5",
    "rimraf": "^6.1.2",
    "tsup": "^9.0.0",
    "typescript": "^5.8.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@astack-tech/core": "workspace:*"
  }
}
